{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "doc_item_vote",
  "type": "object",
  "properties": {
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "result": {
            "enum": [
              "true",
              "false",
              "na"
            ]
          },
          "evidence": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "result",
          "evidence",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "verdicts"
  ],
  "additionalProperties": false
}
