# 공개판 환경변수. 로컬 개발은 아무것도 없어도 뜬다 (PGlite + 개발용 닉네임 로그인 + 로컬 claude -p).
# 실제 값은 .env.local 에 둔다 (git 에 올라가지 않는다).

# 운영자 Anthropic 키: 면접관(Sonnet)과 경량·중량 지원자 호출에 쓴다. 없으면 로컬 Claude Code(claude -p)로 대신한다
ANTHROPIC_API_KEY=

# Supabase Postgres 연결 문자열. 없으면 web/.data/pglite 에 로컬 DB 를 연다
DATABASE_URL=
# Supabase CA 인증서(PEM 내용). 주면 DB 서버 인증서를 검증한다 (없으면 암호화만 한다)
DATABASE_CA_CERT=

# Supabase Auth (GitHub 로그인). 둘 다 없으면 개발용 닉네임 로그인을 쓴다 (production 에서는 꺼진다)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 로그인 뒤 돌아올 사이트 주소 (예: https://arena.example.com). 프록시 뒤에서는 꼭 넣는다
SITE_URL=

# 무제한급 지원자 키를 대기열에 잠깐 담을 때 쓰는 암호화 키 (base64 32바이트, `openssl rand -base64 32`). production 은 필수
ARENA_BYOK_SECRET=

# 선택: 정책 숫자 (lib/policy.ts)
# ARENA_MIDDLE_OPEN=1          # 중량급 열기 (유료 티켓이 붙기 전에는 닫혀 있다)
# ARENA_TICKETS_LIGHT=3
# ARENA_TICKETS_MIDDLE=10
# ARENA_TICKETS_OPEN=10
# ARENA_ACCOUNT_CONCURRENT=2
# ARENA_QUEUE_LIMIT=50
# INTERVIEW_CONCURRENCY=2      # 워커 하나가 동시에 돌리는 면접 단계
# ARENA_WORKER=off             # 이 프로세스에서 워커를 끈다 (웹을 여러 대로 늘릴 때)

# 시험(공격 편성) 시드용 비밀값. 운영 필수. 아무 긴 랜덤 문자열 (예: openssl rand -base64 32)
# 바꾸면 같은 분기·같은 .md 라도 공격 편성이 달라진다. 분기 중간에는 바꾸지 않는다.
ARENA_EXAM_SECRET=
